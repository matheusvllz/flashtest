    {
      "tool": "impeccable init/document",
      "default": "PRODUCT.md / DESIGN.md at repo root",
      "foca": "docs/PRODUCT.md / docs/DESIGN.md (auto-discovered in docs/)"
    },
    {
      "tool": "ui-ux-pro-max --persist",
      "default": "design-system/<app>/MASTER.md",
      "foca": "do not use --persist"
    },
    {
      "tool": "marketing-skills:product-marketing",
      "default": ".agents/product-marketing.md",
      "foca": "exists; points to docs/PRODUCT.md"
    },
    {
      "tool": "repo-security-review",
      "default": ".security-review/",
      "foca": "gitignored; keep final report in docs/ if needed"
    }
  ],
