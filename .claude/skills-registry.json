    {
      "tool": "superpowers:writing-plans",
      "default": "docs/superpowers/plans/",
      "foca": "T-xx tasks inside the spec"
    },
    {
      "tool": "agent-skills:spec-driven-development (/spec)",
      "default": "SPEC.md",
      "foca": "docs/NN-plano-<tema>.md"
    },
    {
      "tool": "agent-skills:planning-and-task-breakdown (/plan)",
      "default": "tasks/plan.md, tasks/todo.md",
      "foca": "T-xx tasks inside the spec; progress in execution registry"
