# ---------------------------------------------------------------------------
# Credenciais da automacao de Instagram do Foca. COPIE para .env (gitignorado).
# Nenhum valor real entra neste arquivo nem no Git.
# ---------------------------------------------------------------------------

# Token de acesso de longa duracao da conta profissional do Instagram.
# Instagram Login  -> host graph.instagram.com, escopos
#                     instagram_business_basic, instagram_business_content_publish
# Facebook Login   -> host graph.facebook.com, escopos
#                     instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN=

# ID da conta profissional do Instagram (IG_ID) usada em POST /<IG_ID>/media.
IG_USER_ID=

# @ da conta, so para conferencia antes de publicar (evita publicar na conta errada).
IG_USERNAME=

# Base publica onde os arquivos exportados ficam acessiveis por HTTPS.
# A API da Meta baixa a midia por URL: caminho de disco nao funciona.
# Ex.: https://cdn.exemplo.com/foca-social
MIDIA_BASE_URL=

# Pasta local que ja e servida por essa base (adaptador "pasta-publica").
# Ex.: C:\Users\mathe\OneDrive\publico\foca-social
MIDIA_PASTA_PUBLICA=
