# Copie este arquivo para `.env` e preencha o que precisar. O `.env` é ignorado pelo Git.
#
# Tudo aqui é lido SÓ no servidor (src/server/env.ts). Nunca prefixe um segredo com VITE_ —
# isso o colocaria no bundle do navegador. Lista completa e onde configurar cada uma na Vercel:
# docs/operacao/ambientes-e-deploy.md §3.
#
# Em desenvolvimento, NADA abaixo é obrigatório: sem DATABASE_URL o app usa um Postgres local em
# processo (PGlite, em .data/pglite), sem RESEND_API_KEY os e-mails vão para .data/emails/ e sem
# OPENAI_API_KEY a Foca IA usa o fallback local.

# --- Foca IA --------------------------------------------------------------------------------
# Gere em https://platform.openai.com/api-keys. Na Vercel: Production e Preview.
OPENAI_API_KEY=
# Cotas por plano (D-12) e teto global de custo por dia, em dólares.
# AI_COTA_GRATIS_MENSAGENS=3
# AI_COTA_PRO_MENSAGENS=20
# AI_COTA_PRO_FOTOS=5
# AI_TETO_DIARIO_USD=1

# --- Banco (Neon) ---------------------------------------------------------------------------
# Na Vercel, a integração do Neon preenche as duas. Localmente, deixe vazio (PGlite).
# DATABASE_URL=              # com pooler; usada pelo app
# DATABASE_URL_UNPOOLED=     # conexão direta; só para `bun run db:migrate`

# --- Autenticação (Better Auth) -------------------------------------------------------------
# Obrigatórias em produção. Gere o segredo com: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://<seu-domínio>
# Origens extras aceitas (separadas por vírgula), ex.: o alias de staging da Vercel.
# AUTH_TRUSTED_ORIGINS=
# Login com Google: um cliente OAuth por ambiente (Google Cloud → APIs e serviços → Credenciais).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Login por e-mail e senha. Em produção fica desligado até existir domínio para o e-mail (D-10).
# AUTH_EMAIL_HABILITADO=true
# Idade mínima para ter conta (ADR 0006) e idade a partir da qual a Foca IA dispensa o consentimento do responsável.
# MIN_ACCOUNT_AGE=17
# TUTOR_IDADE_SEM_CONSENTIMENTO=18

# --- E-mail (Resend) ------------------------------------------------------------------------
# Exige domínio verificado. Remetente no formato "Foca <nao-responda@seu-dominio>".
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Rotinas agendadas (Vercel Cron) --------------------------------------------------------
# CRON_SECRET=

# --- Planos e funções (spec 49) — desligados por padrão em produção --------------------------
# PAGAMENTOS_HABILITADO=
# ASAAS_API_URL=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# VIDAS_HABILITADO=
# ANUNCIOS_HABILITADO=
# ANUNCIOS_PROVEDOR=
# GAM_UNIDADE_RETANGULO=
# GAM_UNIDADE_RECOMPENSADO=
# RANKING_HABILITADO=
# CORRETOR_HABILITADO=
# AI_COTA_GRATIS_MENSAGENS=
# AI_TETO_DIARIO_USD=
# AI_TETO_DIARIO_PAGOS_USD=
# AI_PRECO_ENTRADA_USD_MTOK=
# AI_PRECO_SAIDA_USD_MTOK=

# --- Gamificação e prática (spec 50) --------------------------------------------------------
# Pérolas, missões, mini-simulado, escrita, retrospectiva e "pular para cá" vêm ligados; para pausar sem deploy,
# liste aqui (separados por vírgula): perolas, missoes, miniSimulado, escrita, retrospectiva, pulo.
# FUNCOES_DESLIGADAS=
# Primeiro dia da retrospectiva do ano (AAAA-MM-DD); padrão: o dia seguinte ao 2º domingo de novembro.
# RETROSPECTIVA_INICIO=
# Ligas (com RANKING_HABILITADO) e ofensiva com amigos, 18+: só depois da revisão jurídica.
# LIGAS_HABILITADO=
# AMIGOS_HABILITADO=
# Lembrete diário por push: as chaves VAPID são geradas uma vez por ambiente (a privada só no servidor).
# LEMBRETES_HABILITADO=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# --- Pipeline de conteúdo (fora do app) -----------------------------------------------------
# Só usado por scripts/content/run-stage.ts e import-official-items.ts (offline); nunca lido
# por src/. Endpoint compatível com a API de chat da OpenAI. Rodar a pipeline de verdade exige
# aprovar um orçamento de tokens e revisar a amostra de cada lote (content-pipeline/README.md).
# CONTENT_LLM_BASE_URL=
# CONTENT_LLM_API_KEY=
# CONTENT_LLM_MODEL_GERAR=
# CONTENT_LLM_MODEL_CRITICAR=
# CONTENT_LLM_MODEL_RESOLVER=
# CONTENT_LLM_MODEL_ESCALAR=
# CONTENT_LLM_MODEL_HUMANIZAR=
