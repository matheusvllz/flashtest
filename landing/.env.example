# Valores PÚBLICOS (embutidos no bundle da landing). Não coloque segredo aqui.
# URL onde o app do Foca está publicado. Todos os links "Começar agora" e "Entrar" saem daqui.
VITE_APP_URL=http://localhost:8080
# URL pública desta landing (canonical, og:url, sitemap). Vazio = sem canonical.
VITE_SITE_URL=
# "true" só depois de o proprietário aprovar a publicação. Padrão: noindex.
VITE_LP_INDEXABLE=false
