{
  "name": "foca-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page de marketing do Foca. Isolada do app (docs/40).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.ts",
    "preview": "vite preview",
    "test": "bun test tests/unit",
    "check:isolation": "bun scripts/check-isolation.ts",
    "check:tokens": "bun scripts/check-token-drift.ts",
    "sync:brand": "bun scripts/sync-brand-assets.ts",
    "sync:tokens": "bun scripts/sync-tokens.ts",
    "sync:fonts": "bun scripts/sync-fonts.ts",
    "shots": "bun scripts/capture-product-shots.ts",
    "og": "bun scripts/make-og-image.ts",
    "lighthouse": "bun scripts/lighthouse-run.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
